---
// An app screenshot staged on its backdrop, with separate light and dark captures. Captures are
// taken over a blurred frame of the demo clip so the window glass tints from it, as it would
// over a real wallpaper. Astro generates AVIF/WebP at several widths at build time; the
// `dark:` variant shows the capture for the active theme.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { cn } from 'cn';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { light, dark, alt, sizes = '(min-width: 1240px) 1130px, 100vw', eager = false, class: className } = Astro.props;
const widths = [640, 960, 1280, 1800, 2400].filter((w) => w <= light.width);
const loading = eager ? 'eager' : 'lazy';
---

<figure class={cn('m-0 overflow-hidden rounded-[20px] ring-1 ring-faint', className)}>
  <Picture
    src={light}
    {alt}
    {sizes}
    {widths}
    {loading}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    class="h-auto w-full dark:hidden"
  />
  <Picture
    src={dark}
    {alt}
    {sizes}
    {widths}
    {loading}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    class="hidden h-auto w-full dark:block"
  />
  <slot />
</figure>
