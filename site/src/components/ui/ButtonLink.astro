---
import type { HTMLAttributes } from 'astro/types';
import { cn } from 'cn';

interface Props extends HTMLAttributes<'a'> {
  size?: 'md' | 'sm';
}
const { size = 'md', class: className, ...rest } = Astro.props;
---

<a
  class={cn(
    'inline-flex items-center gap-2.5 rounded-[10px] bg-btn font-semibold text-btn-ink no-underline',
    size === 'md' ? 'px-5 py-3.25 text-base' : 'px-3.5 py-2.25 text-sm',
    className,
  )}
  {...rest}
>
  <slot />
</a>
