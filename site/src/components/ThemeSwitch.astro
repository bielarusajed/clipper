---
// Three-way appearance control: follow the system, or force light or dark.
const options = [
  { value: 'system', label: 'Match system appearance', title: 'System' },
  { value: 'light', label: 'Light appearance', title: 'Light' },
  { value: 'dark', label: 'Dark appearance', title: 'Dark' },
] as const;
---

<div
  class="theme inline-flex gap-0.5 rounded-[10px] border border-faint p-[3px]"
  role="radiogroup"
  aria-label="Appearance"
>
  {options.map((o) => (
    <button
      type="button"
      role="radio"
      data-t={o.value}
      aria-label={o.label}
      title={o.title}
      class="grid h-7 w-7.5 cursor-pointer place-items-center rounded-[7px] text-sub aria-checked:bg-card aria-checked:text-ink aria-checked:shadow-sm"
    >
      <svg
        viewBox="0 0 20 20"
        class="size-4.5"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        {o.value === 'system' && (
          <>
            <rect x="2.5" y="4" width="15" height="10" rx="1.5" />
            <path d="M7 17h6" />
          </>
        )}
        {o.value === 'light' && (
          <>
            <circle cx="10" cy="10" r="3.5" />
            <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4" />
          </>
        )}
        {o.value === 'dark' && <path d="M15.5 12.5A6.5 6.5 0 0 1 7.5 4.5a6.5 6.5 0 1 0 8 8z" />}
      </svg>
    </button>
  ))}
</div>

<script>
  type Choice = 'system' | 'light' | 'dark';
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.theme button')];
  const current = (): Choice => (root.dataset['theme'] as Choice | undefined) ?? 'system';
  const sync = () => {
    for (const b of buttons) b.setAttribute('aria-checked', String(b.dataset['t'] === current()));
  };
  for (const b of buttons) {
    b.addEventListener('click', () => {
      const t = b.dataset['t'] as Choice;
      if (t === 'system') delete root.dataset['theme'];
      else root.dataset['theme'] = t;
      try {
        if (t === 'system') localStorage.removeItem('clipper-theme');
        else localStorage.setItem('clipper-theme', t);
      } catch {
        // Storage can be unavailable (private mode); the choice still applies to this page.
      }
      sync();
    });
  }
  sync();
</script>
