---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import icon from '../assets/icon.svg';
import Rail from '../components/Rail.astro';
import Range from '../components/Range.astro';
import Hero from '../components/Hero.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import TimelineDemo from '../components/TimelineDemo.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import Key from '../components/ui/Key.astro';
import Base from '../layouts/Base.astro';

const frameModules = import.meta.glob<{ default: ImageMetadata }>('../assets/frames/*.jpg', { eager: true });
const frames = Object.entries(frameModules)
  .toSorted(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);
const frame = (i: number) => frames[i % frames.length]!;

const VERSION = '0.6.2';
const REPO = 'https://github.com/bielarusajed/clipper';
const DOWNLOAD = `${REPO}/releases/latest`;
const CLIP = { duration: 90.023, fps: 30000 / 1001 };

const ratios = [
  { name: '16:9', r: 16 / 9 },
  { name: '9:16', r: 9 / 16 },
  { name: '1:1', r: 1 },
  { name: '4:5', r: 4 / 5 },
];
const waveform = Array.from({ length: 64 }, (_, i) => Math.abs(Math.sin(i * 0.41) * Math.cos(i * 0.13)) * 0.85 + 0.12);
const shortcuts: { label: string; keys: string[] }[] = [
  { label: 'Play or pause', keys: ['Space'] },
  { label: 'Step a frame', keys: ['←', '→'] },
  { label: 'Set start and end', keys: ['I', 'O'] },
  { label: 'Loop selection', keys: ['⌘L'] },
  { label: 'Audition the cut', keys: ['⇧⌘L'] },
  { label: 'Undo and redo', keys: ['⌘Z', '⇧⌘Z'] },
  { label: 'Paste a video or URL', keys: ['⌘V'] },
  { label: 'Export clip', keys: ['⌘E'] },
];
const formats = [
  { id: '401', ext: 'mp4', res: '3840×2160', fps: '30', size: '1.9 GB', on: false },
  { id: '137', ext: 'mp4', res: '1920×1080', fps: '30', size: '412 MB', on: true },
  { id: '136', ext: 'mp4', res: '1280×720', fps: '30', size: '188 MB', on: false },
  { id: '140', ext: 'm4a', res: 'audio only', fps: '', size: '31 MB', on: true },
];
const wrap = 'mx-auto max-w-[1240px] px-[clamp(20px,4vw,56px)]';
---

<Base
  title="Clipper: cut a precise clip on your Mac"
  description="Clipper is a free, open-source Mac app for cutting one frame-exact clip out of any video, framing it, and exporting an MP4."
>
  <Rail duration={204} />
  <main class="ml-9 md:ml-19">
    <div class={wrap}>
      <header class="flex flex-wrap items-center gap-3.5 py-5.5 md:gap-5.5">
        <a href="#" class="flex items-center gap-2.5 text-[19px] font-bold text-ink no-underline">
          <Image src={icon} alt="" width={30} height={30} />
          Clipper
        </a>
        <nav aria-label="Page" class="ml-auto hidden gap-5.5 text-[15px] md:flex">
          <a href="#mark" class="text-sub no-underline hover:text-ink">
            Features
          </a>
          <a href="#keys" class="text-sub no-underline hover:text-ink">
            Shortcuts
          </a>
          <a href={REPO} class="text-sub no-underline hover:text-ink">
            Source
          </a>
        </nav>
        <div class="ml-auto md:ml-0">
          <ThemeSwitch />
        </div>
        <ButtonLink href={DOWNLOAD} size="sm">
          Download
        </ButtonLink>
      </header>
    </div>

    <Hero version={VERSION} downloadUrl={DOWNLOAD} />

    <section aria-label="Filmstrip" class="mt-28 mb-10 overflow-hidden border-y border-faint py-6.5">
      <div class="relative">
        <div class="reel flex w-max translate-x-(--x) gap-1 will-change-transform motion-reduce:translate-x-0">
          {[...frames, ...frames].map((f) => (
            <Image
              src={f}
              alt=""
              widths={[180, 360]}
              sizes="180px"
              loading="lazy"
              class="h-[101px] w-[180px] flex-none rounded object-cover"
            />
          ))}
        </div>
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -inset-y-2 left-[calc(50%-150px)] w-[300px] rounded-md border-x-14 border-y-4 border-amber md:left-[calc(50%-280px)] md:w-[560px]"
        ></div>
      </div>
      <p class="mx-auto mt-5.5 max-w-[42ch] px-5 text-center text-[17px] text-sub">
        Every thumbnail, step and timestamp comes from a real decoded frame. Clipper opens MP4, MOV, MKV, WebM and AVI
        straight away, with no proxy files to wait for.
      </p>
    </section>

    <div class={wrap}>
      <Range id="mark">
        <Fragment slot="copy">
          <h2>Mark the exact frames</h2>
          <p>
            Press <b>I</b> on the first frame you want and <b>O</b> on the last. Left and Right step one frame at a
            time, even in variable-frame-rate phone video.
          </p>
          <p>
            Start and End are editable. Type seconds or a full timestamp and Clipper snaps to the nearest real frame.
          </p>
        </Fragment>
        <TimelineDemo
          slot="viz"
          frames={frames.filter((_, i) => i % 2 === 0)}
          duration={CLIP.duration}
          fps={CLIP.fps}
        />
      </Range>

      <Range>
        <Fragment slot="copy">
          <h2>Hear where it cuts</h2>
          <p>
            Loop the selection while you nudge an edge. Audition plays the last second before the out point once and
            holds the final frame, so you can hear whether a word gets clipped.
          </p>
          <p>Turn on the waveform to see speech and beats under the filmstrip.</p>
        </Fragment>
        <div slot="viz" class="flex h-40 items-center gap-0.5 p-6" aria-hidden="true">
          {waveform.map((v, i) => (
            <i
              class:list={['flex-1 rounded-xs', i > 18 && i < 44 ? 'bg-amber' : 'bg-sub/55']}
              style={`height:${(v * 100).toFixed(1)}%`}
            />
          ))}
        </div>
      </Range>

      <Range>
        <Fragment slot="copy">
          <h2>Frame it for where it’s going</h2>
          <p>
            Crop to 16:9, 9:16, 1:1, 4:5 or your own ratio, then drag the crop where the action is. Resolution presets
            only ever scale down.
          </p>
          <p>Speed runs from 0.25× to 4× with the pitch kept natural.</p>
        </Fragment>
        <div slot="viz" class="flex flex-wrap items-end gap-4.5 p-6">
          {ratios.map(({ name, r }) => (
            <figure class="m-0 flex flex-col items-center gap-2 text-sm text-sub">
              <Image
                src={frame(6)}
                alt=""
                widths={[200, 400]}
                sizes="200px"
                class="rounded border-2 border-ink object-cover"
                style={`aspect-ratio:${r};${r >= 1 ? `width:${Math.min(190, 150 * r)}px` : 'height:150px;width:auto'}`}
              />
              <figcaption>{name}</figcaption>
            </figure>
          ))}
        </div>
      </Range>

      <Range>
        <Fragment slot="copy">
          <h2>Check it before you wait for it</h2>
          <p>
            Preview 5 s encodes a real sample with your settings. Compare puts a wipe between the original and the
            output so you can judge the quality slider by eye.
          </p>
          <p>Hardware H.264 and H.265 encoding. HDR stays HDR, or converts to SDR when you ask.</p>
        </Fragment>
        <div slot="viz" class="relative aspect-video" aria-hidden="true">
          <Image src={frame(3)} alt="" widths={[640]} sizes="560px" class="absolute inset-0 size-full object-cover" />
          <Image
            src={frame(3)}
            alt=""
            widths={[640]}
            sizes="560px"
            class="absolute inset-0 size-full object-cover contrast-105 saturate-[.85] [clip-path:inset(0_0_0_50%)]"
          />
          <span class="absolute inset-y-0 left-1/2 w-0.5 bg-white"></span>
          <span class="absolute top-2.5 left-2.5 rounded-[5px] bg-black/55 px-2 py-0.5 text-xs text-white">
            Original
          </span>
          <span class="absolute top-2.5 right-2.5 rounded-[5px] bg-black/55 px-2 py-0.5 text-xs text-white">
            Output
          </span>
        </div>
      </Range>

      <Range>
        <Fragment slot="copy">
          <h2>Clip from a link</h2>
          <p>
            Paste a URL with Cmd-V. Clipper downloads the best video and audio, or lets you pick formats from a table.
            For long streams, import only a rough time range.
          </p>
          <p>Burn in subtitles from the video or from an SRT, WebVTT, ASS or SSA file.</p>
        </Fragment>
        <table slot="viz" class="my-3.5 w-full border-collapse text-sm">
          <thead>
            <tr class="text-left text-sub">
              {['ID', 'Ext', 'Resolution', 'FPS', 'Size'].map((h) => (
                <th class="border-b border-faint px-4 py-2 font-medium">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {formats.map((f) => (
              <tr class:list={[f.on && 'bg-accent/14']}>
                {[f.id, f.ext, f.res, f.fps, f.size].map((c) => (
                  <td class="border-b border-faint px-4 py-2">{c}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </Range>

      <Range id="keys" wide>
        <Fragment slot="copy">
          <h2>Keep your hands on the keys</h2>
          <dl class="mt-3 grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-x-10 gap-y-0.5">
            {shortcuts.map((s) => (
              <div class="flex items-center justify-between gap-3 border-b border-faint py-3 text-base">
                <dt>{s.label}</dt>
                <dd class="m-0 flex gap-1.5">
                  {s.keys.map((k) => (
                    <Key>{k}</Key>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </Fragment>
      </Range>

      <footer class="grid gap-5.5 pt-25 pb-35 [&_p]:m-0 [&_p]:max-w-[60ch] [&_p]:text-base [&_p]:text-sub">
        <h2 class="m-0 max-w-[14ch] text-[clamp(40px,6vw,84px)] leading-none font-semibold tracking-[-0.03em]">
          Mark in. Mark out. Done.
        </h2>
        <div>
          <ButtonLink href={DOWNLOAD}>Download Clipper {VERSION}</ButtonLink>
        </div>
        <p>
          Builds are ad-hoc signed for now, so the first launch may need approval in System Settings, Privacy &amp;
          Security. Everything runs locally; the media engine is bundled, so there’s no Homebrew or terminal involved.
        </p>
        <p>
          <a href={REPO}>Source on GitHub</a>, <a href={`${REPO}/blob/main/CHANGELOG.md`}>release notes</a>,
          <a href={`${REPO}/blob/main/docs/guide.md`}>user guide</a>.
        </p>
        <p class="text-sm!">
          Clipper is free software under the <a href={`${REPO}/blob/main/LICENSE`}>GNU GPL v3.0 or later</a>. Demo
          footage: NASA/JSC, 4K Earth Views (2021).
        </p>
      </footer>
    </div>
  </main>
</Base>

<script>
  // The filmstrip band drifts sideways as the page scrolls past it.
  const reel = document.querySelector<HTMLElement>('.reel');
  if (reel && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let pending = false;
    const move = () => {
      pending = false;
      const r = reel.parentElement?.getBoundingClientRect();
      if (r) reel.style.setProperty('--x', `${-(innerHeight - r.top) * 0.6}px`);
    };
    addEventListener(
      'scroll',
      () => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(move);
      },
      { passive: true },
    );
    move();
  }
</script>
